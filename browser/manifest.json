{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Night Filter",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_name__",
    "default_icon": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["state.js", "filter-urls.js", "content.js"], "run_at": "document_start" }
  ],
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "__MSG_command__"
    }
  }
}
